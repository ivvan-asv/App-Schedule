PROJECT_NAME="Smart Scheduler AI"
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/smart_scheduler_db"
REDIS_URL="redis://localhost:6379/0"
CORS_ORIGINS="http://localhost:3000"
ANTHROPIC_API_KEY=""
CAPTURE_LLM_MODEL="claude-haiku-5-5"

# --- Calendarios externos (Google / Outlook) ---------------------------------
# Paso a paso para obtener cada valor: docs/calendar-credentials.md
# URL pública de este backend tal como la ve el navegador del usuario.
# En el simulador basta http://localhost:8000; en un iPhone usa un túnel HTTPS.
OAUTH_REDIRECT_BASE_URL="http://localhost:8000"
APP_OAUTH_CALLBACK_URL="smartscheduler://calendar-connected"
# Genera la clave con:
#   python3 -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=""
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra > Registros de aplicaciones > (tu app) > Certificados y secretos
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
